# Spotify owner credentials for `npm run music:fetch` (never commit .env.local).
# 1. Create an app at https://developer.spotify.com/dashboard (redirect URI http://127.0.0.1:8888/callback).
# 2. One-time authorize with user-top-read. Add user-follow-read and
#    playlist-read-private if you want FRONTIER to learn followed artists and
#    private playlist names as discovery signals too.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# FRONTIER personal intelligence radar.
# The page works without any of these keys: Hacker News, OpenAlex, GitHub's
# anonymous API allowance, specialist RSS, Reddit public listings, and Steam
# public game news provide the zero-config core. Keys widen discovery and rate limits.
FRONTIER_GITHUB_TOKEN=
BRAVE_SEARCH_API_KEY=
FOOTBALL_DATA_API_KEY=

# Optional OpenAlex polite-pool identity / API access.
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Extra comma-separated RSS URLs to monitor in addition to the default Guardian
# football feed. FRONTIER normalizes media, classification, provenance, and ranking.
FRONTIER_RSS_FEEDS=

# Optional comma-separated YouTube channel IDs. FRONTIER reads YouTube's public
# Atom feeds and turns fresh uploads into first-class playable video signals.
# Example shape: UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
FRONTIER_YOUTUBE_CHANNELS=

# Optional extra subreddits beyond the checked-in personal subscription orbit.
# Team communities for the Patriots, Warriors, Chelsea, and Manchester City are
# already pinned into the daily rotation.
FRONTIER_SUBREDDITS=

# The daily GitHub Action can use these same values as repository Variables /
# Secrets. Each refresh commits content/frontier/latest.json to master, which
# gives Vercel a durable daily snapshot and naturally triggers a new deployment.
