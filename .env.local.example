# Spotify owner credentials for `npm run music:fetch` (never commit .env.local).
# 1. Create an app at https://developer.spotify.com/dashboard (redirect URI http://127.0.0.1:8888/callback).
# 2. One-time authorize with user-top-read. Add user-follow-read and
#    playlist-read-private if you want FRONTIER to learn followed artists and
#    private playlist names as discovery signals too.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# FRONTIER Google identity + private cross-device memory.
# Create an OAuth Web application in Google Cloud and register:
#   https://sidhulyalkar.com/api/auth/google/callback
# For local development also register:
#   http://localhost:3000/api/auth/google/callback
# FRONTIER asks only for openid/email/profile at sign-in. YouTube read-only
# permission is requested separately when the signed-in user clicks Import YouTube taste.
FRONTIER_GOOGLE_CLIENT_ID=
FRONTIER_GOOGLE_CLIENT_SECRET=
FRONTIER_AUTH_SECRET=
FRONTIER_AUTH_ORIGIN=https://sidhulyalkar.com

# Private remote memory. FRONTIER talks to the Upstash/Vercel Redis REST API
# directly, so no database package is required. Either FRONTIER_* or the standard
# UPSTASH_* / KV_REST_* names work. Use a private Redis database for this data.
FRONTIER_REDIS_REST_URL=
FRONTIER_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# FRONTIER personal intelligence radar.
# The page works without any discovery keys: Hacker News, OpenAlex, GitHub's
# anonymous API allowance, GDELT, specialist RSS, Reddit public listings, and
# Steam public game news provide the zero-config core. Keys widen discovery and rate limits.
FRONTIER_GITHUB_TOKEN=
BRAVE_SEARCH_API_KEY=
FOOTBALL_DATA_API_KEY=

# Optional OpenAlex polite-pool identity / API access.
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Extra comma-separated RSS URLs to monitor in addition to the default Guardian
# football feed. FRONTIER normalizes media, classification, provenance, and ranking.
FRONTIER_RSS_FEEDS=

# Optional comma-separated YouTube channel IDs. FRONTIER reads YouTube's public
# Atom feeds and turns fresh uploads into first-class playable video signals.
# Example shape: UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
FRONTIER_YOUTUBE_CHANNELS=

# Optional extra subreddits beyond the checked-in personal subscription orbit.
# Team communities for the Patriots, Warriors, Chelsea, and Manchester City are
# already pinned into the daily rotation.
FRONTIER_SUBREDDITS=

# Optional comma-separated artists that should join the checked-in/Spotify taste
# profile for broad-web and SoundCloud discovery. Useful for followed SoundCloud
# artists that are not represented in the Spotify owner profile yet.
FRONTIER_MUSIC_ARTISTS=

# Optional additional trusted image CDN hosts for FRONTIER's same-origin GPU media
# proxy. The proxy is image-only, DNS/private-IP checked, redirect bounded, timeout
# bounded, and capped at 16 MB. Common YouTube/Reddit/Steam media CDNs are already
# allowlisted in code. Add only media hosts you trust, never arbitrary user domains.
# Example: images.example.com,cdn.example.org
FRONTIER_MEDIA_PROXY_HOSTS=

# The daily GitHub Action can still use discovery values as repository Variables /
# Secrets to maintain a durable snapshot. The live FRONTIER page does not require
# a redeploy for fresh content; request-time APIs are the primary transport.
