# Spotify owner credentials for `npm run music:fetch` (never commit .env.local).
# 1. Create an app at https://developer.spotify.com/dashboard (redirect URI http://127.0.0.1:8888/callback).
# 2. One-time authorize (scope user-top-read) to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# FRONTIER personal intelligence radar.
# The page works without any of these keys: Hacker News, OpenAlex, GitHub's
# anonymous API allowance, and specialist RSS feeds provide the zero-config core.
# Keys widen the discovery surface and increase rate limits.
FRONTIER_GITHUB_TOKEN=
BRAVE_SEARCH_API_KEY=
FOOTBALL_DATA_API_KEY=

# Optional OpenAlex polite-pool identity / API access.
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Extra comma-separated RSS/Atom URLs to monitor in addition to the default
# Guardian football feed. Keep this server-side; FRONTIER normalizes media,
# classification, and ranking after ingestion.
FRONTIER_RSS_FEEDS=
